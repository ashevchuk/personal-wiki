<%c++
// House rules for CSP templates in this project: see the comment above
// drogon_create_views() in CMakeLists.txt, and docs/architecture.md.
%>
<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta name="wiki-base-path" content="[[basePath]]">
<title>Search — wiki</title>
<link rel="stylesheet" href="[[basePath]]/css/theme.css">
<script src="[[basePath]]/js/htmx/htmx.min.js"></script>
</head>
<body>
<canvas id="matrix-bg"></canvas>
<div class="layout">
<nav class="sidebar">
  <a class="sidebar-brand" href="[[basePath]]/">wiki</a>
  <div class="sidebar-links">
    <a href="[[basePath]]/search">Search</a>
    <a href="[[basePath]]/folder">Browse</a>
    <a href="[[basePath]]/edit/untitled.md">+ New</a>
  </div>
  <div class="sidebar-section"><h3>Tags</h3><div id="nav-tags"></div></div>
  <div class="sidebar-section"><h3>Documents</h3><div id="nav-tree"></div></div>
</nav>
<main class="content">
<h1>Search</h1>
<form onsubmit="return false" class="search-form">
  <input type="search" name="q" placeholder="Search documents..." value="[[qValue]]"
         hx-get="[[basePath]]/api/search" hx-trigger="keyup changed delay:300ms, search"
         hx-target="#results" hx-include="[name='tag'],[name='type']" autofocus>
  <input type="text" name="tag" placeholder="tag" value="[[tagValue]]"
         hx-get="[[basePath]]/api/search" hx-trigger="keyup changed delay:300ms, change"
         hx-target="#results" hx-include="[name='q'],[name='type']">
  <input type="text" name="type" placeholder="type" value="[[typeValue]]"
         hx-get="[[basePath]]/api/search" hx-trigger="keyup changed delay:300ms, change"
         hx-target="#results" hx-include="[name='q'],[name='tag']">
</form>
<div id="results">
[[resultsHtml]]
</div>
</main>
</div>
<!-- common.js MUST load before nav.js/folder.js — both read
     window.WikiCommon at their own top level. -->
<script src="[[basePath]]/js/common.js"></script>
<script src="[[basePath]]/js/matrix.js"></script>
<script src="[[basePath]]/js/nav.js"></script>
<script src="[[basePath]]/js/folder.js"></script>
</body>
</html>
