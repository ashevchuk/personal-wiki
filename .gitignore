# build artifacts
build/
build-arm/
build-fuzz/
build-asan/
out/

# vcpkg (bootstrapped locally, not vendored in git — see docs/architecture.md)
vcpkg/
vcpkg_installed/
vcpkg_installed_arm/

# local runtime data — never commit real vault content or the index db
vault_data/*
!vault_data/.gitkeep
*.db
*.db-journal
*.db-wal

# secrets / local config
.env
*.env
config.local.toml

# Toast UI Editor bundle is vendored and DELIBERATELY committed (see
# tools/build-editor-bundle/fetch.sh + static/js/toastui-editor/VENDORED.md)
# so a checkout builds/deploys with no network access beyond vcpkg — do
# not add an ignore rule for it back.

# IDE / OS noise
.vscode/
.idea/
*.swp
.DS_Store

# Python bytecode cache (tests/integration/_stress_common.py etc. get
# imported by the stress scripts, not just run standalone)
__pycache__/
*.pyc

# Claude Code session-local state (scheduled-task locks, etc.) — not
# project content
.claude/
CLAUDE.md
claude.sh

# CMake user presets (machine-local)
CMakeUserPresets.json
