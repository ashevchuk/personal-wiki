# Copy to deploy.local.env (tools/wiki-ops.sh config init does this for
# you) and fill in your own real deployment target. deploy.local.env is
# gitignored (.gitignore's existing `.env`/`*.env` rules already cover
# it) — this keeps the real host/IP/domain out of a public git history,
# same reasoning as docs/sbc-deployment.md's "Recording your own live
# deployment target" section. Never put a real secret VALUE in here —
# only the two *_API_KEY_ENV fields below, which name an environment
# variable on the target, not a key itself.

# ssh target for `wiki-ops.sh deploy`, e.g. root@192.0.2.10. Leave empty
# for a local install (no ssh/scp involved at all).
WIKI_DEPLOY_HOST=

WIKI_DEPLOY_SSH_PORT=22

# Where the app lives on the target (or locally, if WIKI_DEPLOY_HOST is empty).
WIKI_DEPLOY_INSTALL_ROOT=/opt/wiki

# native | cross | container | cross-container | container-arm
WIKI_DEPLOY_VARIANT=cross

WIKI_DEPLOY_SERVICE_USER=wiki

# Blank = 8080. For native/cross/cross-container this becomes
# config.toml's [server].port directly; for container/container-arm
# it's only the HOST side of the docker port mapping — the container's
# own internal port stays 8080 either way (see docker-compose.yml).
WIKI_DEPLOY_PORT=

# Used by `nginx-config` and the base_path reminder — optional.
WIKI_DEPLOY_DOMAIN=
WIKI_DEPLOY_BASE_PATH=

# Only consulted by you, by hand, when setting up
# systemd/wiki-backup.env on the target — wiki-ops.sh does not read this
# itself. Point it at a DIFFERENT disk/mount than the vault.
WIKI_DEPLOY_BACKUP_DIR=

WIKI_DEPLOY_WITH_BACKUP_TIMER=false

# Env VAR NAMES only (e.g. "WIKI_EMBEDDINGS_API_KEY") — mirrors
# config.toml's own [embeddings]/[llm].api_key_env indirection. The
# actual secret value is never stored here; wiki-ops.sh prompts for it
# with echo disabled when it actually needs to write wiki.env on a target.
WIKI_DEPLOY_EMBEDDINGS_API_KEY_ENV=
WIKI_DEPLOY_LLM_API_KEY_ENV=
