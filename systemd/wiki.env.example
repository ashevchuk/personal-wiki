# Copy to /etc/wiki/wiki.env (mode 600, owned by the `wiki` user) and fill
# in real values. Never commit the filled-in version.

# Argon2id hash produced by `wiki-server --create-admin`, not a plaintext
# password.
WIKI_ADMIN_PASSWORD_HASH=

# Random 32+ byte secret used to sign session cookies. Generate with e.g.
# `openssl rand -hex 32`.
WIKI_SESSION_SECRET=
