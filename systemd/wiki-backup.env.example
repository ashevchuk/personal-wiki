# Copy to /etc/wiki/wiki-backup.env (referenced by wiki-backup.service's
# EnvironmentFile=-/etc/wiki/wiki-backup.env — leading '-', same reasoning
# as wiki.env.example: systemd won't refuse to start the unit just because
# this file doesn't exist yet, but wiki-backup.sh itself DOES require
# VAULT_PATH/BACKUP_DIR to be set, so the unit fails loudly at run time
# instead of silently backing up nothing).

VAULT_PATH=/opt/wiki/vault_data

# Point this at a DIFFERENT disk/mount than VAULT_PATH above -- an
# external USB drive, a network share, another machine over sshfs/NFS,
# anything that doesn't share the same physical failure as the SD card
# VAULT_PATH lives on. A backup directory on the SAME disk only protects
# against "I fat-fingered a delete", not "the SD card died", which is the
# actual disaster this exists for (see docs/deployment.md's "Backup"
# section).
BACKUP_DIR=/mnt/backup/wiki

# How many past backups to keep (oldest pruned first, after each new one
# lands successfully). Default matches the timer's own default cadence
# (daily) for ~2 weeks of history; raise it if disk space on BACKUP_DIR
# allows and you want more history, lower it if it doesn't.
RETENTION_COUNT=14
