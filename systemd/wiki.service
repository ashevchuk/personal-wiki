[Unit]
Description=Personal Wiki server
After=network.target

[Service]
Type=simple
User=wiki
Group=wiki
ExecStart=/opt/wiki/bin/wiki-server
WorkingDirectory=/opt/wiki
# Leading '-': optional. The file is allowed to not exist. When it does,
# CloudEmbeddingProvider getenv()s the variable named by
# embeddings.api_key_env in config.toml (see systemd/wiki.env.example).
# Admin credentials still live in the SQLite users table (set via
# `wiki-server --create-admin`); sessions are random opaque tokens
# validated by DB lookup, not signed by a secret from this file. Without
# the '-', systemd would refuse to start this unit at all if the file
# doesn't exist.
EnvironmentFile=-/etc/opt/wiki/wiki.env
Restart=on-failure
RestartSec=2

# Hardening — the service only ever needs to read/write the vault and the
# index db (db_path lives INSIDE vault_data by default, see
# config.example.toml — one ReadWritePaths entry covers both); everything
# else on the filesystem stays off-limits.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/wiki/vault_data

# SystemCallFilter is deliberately NOT included below.
# SystemCallFilter=@system-service works cleanly on x86_64/glibc
# (systemd 261), but on armv7/musl (systemd 232, the cross-compiled
# arm-linux-musleabihf/musl-static binary) it kills the process outright
# with a seccomp SIGSYS (`code=killed, status=31/SYS`): the filter is
# correctly recognized and enforced there, it just blocks a real syscall
# this binary needs. @system-service's exact syscall set is
# architecture- and systemd-version-dependent, and this project
# statically links musl specifically for the ARM target (see
# docs/architecture.md's Cross-compilation section), which can make
# different libc-internal syscalls than glibc for the same C++
# operation. systemd 232 logs no syscall number for a SIGSYS kill, so
# identifying the exact blocked call needs an ARM-static strace or an
# offline seccomp-audit setup — not guessing against a live service.
#
# Every other directive here is a namespace/mount/capability-level
# restriction (what the process can SEE or ACCESS), not a syscall-level
# allowlist (what the process can DO) — a fundamentally lower-risk
# category that doesn't depend on the exact set of syscalls a given
# libc+arch combination happens to make. If a syscall-level filter is
# ever reattempted, test it against a genuine offline ARM-static-binary
# run first — not qemu-arm-static, which emulates INSTRUCTIONS, not
# kernel seccomp filtering, so it structurally cannot catch this class
# of failure — and roll out with SystemCallErrorNumber=EPERM initially
# rather than the default kill, so a wrong guess degrades to a caught,
# loggable error instead of a crash loop on a live service.
#
# CapabilityBoundingSet= (empty) has its own real, non-obvious
# dependency worth knowing before touching User=/file ownership:
# dropping ALL capabilities means the process loses CAP_DAC_OVERRIDE,
# root's usual "ignore file permission bits" superpower. Running as
# root WITHOUT CAP_DAC_OVERRIDE against a directory some other uid
# owns fails with "attempt to write a readonly database", not a
# permissions-sounding error. This is a
# non-issue for the real deployment as documented here (`useradd wiki`
# + `chown wiki:wiki vault_data`, see docs/deployment.md) since the
# service already owns every path it writes to — but if ReadWritePaths
# or User= ever changes, re-verify this specific dependency, don't
# assume it still holds.
#
# `systemd-analyze security wiki.service` after deploying this is still
# worth running for its score/report, but isn't a substitute for a live
# exercise on the ACTUAL target architecture+libc — it can't catch a
# runtime failure like the one above, only static configuration issues,
# and (as this incident showed) same-directive-different-arch behavior
# isn't a static property at all.
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
PrivateDevices=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
